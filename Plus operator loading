#include <iostream>
using namespace std;

class Number
{
    int n;

public:
    Number(int x = 0)
    {
        n = x;
    }

    Number operator+(Number obj)
    {
        Number temp;
        temp.n = n + obj.n;
        return temp;
    }

    void display()
    {
        cout << "Sum = " << n;
    }
};

int main()
{
    Number a(10), b(20), c;

    c = a + b;

    c.display();

    return 0;
}
