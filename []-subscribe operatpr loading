#include <iostream>
using namespace std;

class Array
{
    int a[5];

public:
    Array()
    {
        for (int i = 0; i < 5; i++)
            a[i] = i + 1;
    }

    int operator[](int index)
    {
        return a[index];
    }
};

int main()
{
    Array obj;

    cout << obj[2];

    return 0;
}
