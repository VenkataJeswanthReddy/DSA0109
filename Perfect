#include <iostream>
using namespace std;
int main() {
    long long n;
    cin >> n;
    if (n <= 1) {
        cout << "Not Perfect";
        return 0;
    }
    long long sum = 1; // 1 is a proper divisor for n > 1
    for (long long i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            sum += i;
            long long j = n / i;
            if (j != i) sum += j; 
        }
    }
    if (sum == n) cout << "Perfect";
    else cout << "Not Perfect";
    return 0;
}
