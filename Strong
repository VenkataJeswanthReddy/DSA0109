
#include <iostream>
using namespace std;

int main() {
    long long n;
    cin >> n;

    if (n < 0) {
        cout << "Not Strong";
        return 0;
    }

    long long original = n;
    long long sum = 0;

    while (n > 0) {
        int digit = n % 10;

        long long fact = 1;
        for (int i = 2; i <= digit; i++) {
            fact *= i;
        }

        sum += fact;
        n /= 10;
    }

    if (sum == original)
        cout << "Strong";
    else
        cout << "Not Strong";

    return 0;
}
