
#include <iostream>
using namespace std;

int nextNumber(int n) {
    int sum = 0;
    while (n > 0) {
        int digit = n % 10;
        sum += digit * digit;
        n /= 10;
    }
    return sum;
}

bool isHappy(int n) {
    int slow = n, fast = n;

    // Floyd cycle detection
    do {
        slow = nextNumber(slow);
        fast = nextNumber(nextNumber(fast));
    } while (slow != fast);

    return slow == 1;
}

int main() {
    int n;
    cin >> n;

    if (isHappy(n))
        cout << "Happy";
    else
        cout << "Not Happy";

    return 0;
}
