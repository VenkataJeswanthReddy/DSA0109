#include <iostream>
using namespace std;

class Number
{
    int n;

public:
    Number(int x = 0)
    {
        n = x;
    }

    void operator++()
    {
        n++;
    }

    void display()
    {
        cout << "Value = " << n;
    }
};

int main()
{
    Number a(5);

    ++a;

    a.display();

    return 0;
}
